# --- Phase 1.4A: production hardening ---

# Environment files: ignore every variant, keep the committed template.
.env*
!.env.example

# Composer credentials (may contain private repo tokens).
auth.json

# Application logs must never be version controlled.
/storage/logs/*.log

# Framework cache artifacts (regenerated at runtime).
/storage/framework/cache/*
!/storage/framework/cache/.gitignore

# Local database dumps only. Installer SQL under database/ and
# installation/ is intentionally tracked and must NOT be ignored.
*.local.sql
*.dump
/backup/